# Variables de entorno de afa-web.
#
# Copia este fichero a `.env.local` y rellena los valores. Las VITE_* las hornea
# Vite EN TIEMPO DE BUILD: si falta una, no hay error, hay `undefined` dentro del
# bundle publicado. Por eso scripts/check-invariants.mjs exige que toda variable
# leída por el código aparezca aquí.
#
# Producción: se configuran en Vercel → Settings → Environment Variables.

# --- Obligatorias -----------------------------------------------------------

# Proyecto de Supabase. La anon key es pública por diseño (viaja en el bundle);
# la que NUNCA va aquí ni en el repositorio es la service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Opcionales -------------------------------------------------------------

# Dominio del acortador de URLs (proyecto go-proxy). Sin él, los enlaces cortos
# se generan contra el dominio principal.
VITE_SHORT_LINK_BASE_URL=https://go.afafalguera.com

# Pone la web en modo mantenimiento sin desplegar código nuevo.
VITE_MAINTENANCE_MODE=false

# Versión que se muestra en el pie y se adjunta a los errores de navegador.
VITE_APP_VERSION=dev

# Proxy de traducción propio. Si no se define, se usa la Edge Function.
VITE_TRANSLATION_PROXY_URL=

# Permite traducir sin sesión (solo para desarrollo: en producción se deja
# vacío para que traducir exija ser admin).
VITE_ALLOW_PUBLIC_TRANSLATION_FALLBACK=

# --- Edge Functions (Supabase → Edge Functions → Secrets) --------------------
#
# No van en .env.local: se configuran en el panel de Supabase o con
# `supabase secrets set`. Se listan aquí para que exista un sitio donde
# mirar qué espera cada función.

# Las inyecta Supabase sola en cada función; no hay que configurarlas.
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# Envío de correo (Resend) — send-inscription-email, send-order-email,
# send-contact-email, usage-alert, activity-alert.
# RESEND_API_KEY
# FROM_EMAIL
# NOTIFICATION_EMAILS

# Traducción automática del contenido — translate.
# GEMINI_API_KEY

# Control de acceso de las funciones.
# ADMIN_EMAILS
# ALLOWED_ORIGINS
# WEBHOOK_SECRET

# Secreto compartido con pg_cron: lo mandan usage-alert y activity-alert en la
# cabecera x-alert-secret. Se guarda además en vault (ver las migraciones de
# cron) para que no aparezca en texto plano en ningún SQL.
# USAGE_ALERT_SECRET
